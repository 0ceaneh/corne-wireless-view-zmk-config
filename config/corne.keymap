#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// -----------------------------------------------------------------------------------------
// Layout : 12, 12, 12, 6

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
    keymap {
      compatible = "zmk,keymap";
      default_layer {
        display-name = "Base";
        bindings = <
// -----------------------------------------------------------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |       |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | TAB  |  A  |  S  |  D  |  F  |  G  |       |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |       |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | RSE | GUI | ENT |       | SPC | CTRL | LWR |
// -----------------------------------------------------------------------------------------
  
// Row 0
&kp ESC &kp Q &kp W &kp E &kp R &kp T 
&kp Y &kp U &kp I &kp O &kp P &kp BSPC

// Row 1
&kp TAB   &kp A  &kp S  &kp D  &kp F     &kp G
&kp H     &kp J  &kp K  &kp L  &kp SEMI  &kp SQT

// Row 2
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B 
&kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT

// Row 3
&mo 2 &kp LGUI &kp RET &kp SPACE &kp LCTRL &mo 1

// -----------------------------------------------------------------------------------------                   
      >;
      };
      lower_layer {
        display-name = "Lower";
        bindings = <

// -----------------------------------------------------------------------------------------
// |   `  |  1  |  2  |  3  |  4  |  5  |       |  6  |  7  |  8  |  9  |  0  | BKSP |
// |   =  |  +  |  -  |  _  |  (  |  )  |       |  {  |  }  |  [  |  ]  |  ~  |      |
// | SHFT |     |     |     |     |     |       |     |     |     |     |     |      |
//                    |     | GUI | ENT |       | SPC | CTRL|     |
// -----------------------------------------------------------------------------------------
  
  // Row 0
  &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   
  &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC

  // Row 1
  &kp EQUAL &kp PLUS &kp MINUS &kp UNDER &kp LPAR &kp RPAR 
  &kp LBRC &kp RBRC &kp LBKT &kp RBKT &kp TILDE &trans

  // Row 2
  &kp LSHFT &trans &trans &trans &trans &trans 
  &trans &trans &trans &trans &trans &kp RSHFT

  // Row 3
  &trans &kp LGUI &kp RET &kp SPACE &kp LCTRL &trans
// -----------------------------------------------------------------------------------------                   
      >;
      };
      raise_layer {
        display-name = "Raise";
        bindings = <
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |       |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |       | PGU |     |     |     |  \  |  `   |
// | SHFT |     |     |     |     |     |       | PGD |  +  |  {  |  }  | "|" |  ~   |
//                    |     | GUI | ENT |       | SPC | CTRL|     |
// -----------------------------------------------------------------------------------------

  // Row 0
  &kp TAB &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
  &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC

  // Row 1
  &kp LCTRL &trans &trans &trans &trans &trans
  &kp PG_UP &trans &trans &kp RBKT &kp BSLH &kp GRAVE

  // Row 2
  &kp LSHFT &trans &trans &trans &trans &trans
  &kp PG_DN &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &kp TILDE

  // Row 3 
  &trans &kp LGUI &kp RET &kp SPACE &kp LCTRL &trans
// ----------------------------------------------------------------------------------------- 
      >;
      };
    adjust_layer {
      display-name = "Mod";
      // Layout : 12, 12, 12, 6
      bindings = <
// -----------------------------------------------------------------------------------------
// | BCLR | BT1 | BT2 | BT3 | BT4 | BT5 |       | VUP |     |     |     |     |      |
// |      |     |     |     |     |     |       | VDN |     |     |     |     |      |
// |      |     |     |     |     |     |       |     |     |     |     |     |      |
//                    |     |     |     |       |     |     |     |
// -----------------------------------------------------------------------------------------
        // Row 0
        &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
        &kp K_VOL_UP &trans &trans &trans &trans &trans

        // Row 1
        &trans &trans &trans &trans &trans &trans
        &kp K_VOL_DN &trans &trans &trans &trans &trans

        // Row 2
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

        // Row 3
        &trans &trans &trans   &trans &trans &trans
      >;
    };

    extra_1 {
      status = "reserved";
    };

    extra_2 {
      status = "reserved";
    };

    extra_3 {
      status = "reserved";
    };
  };
};

